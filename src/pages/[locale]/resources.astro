---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Container from "@/components/Container.astro";
import PageHeader from "@/components/PageHeader.astro";
import Prose from "@/components/Prose.astro";
import { getEntry, render } from "astro:content";
import { getDictionary, type Locale } from "@/i18n/locales";

export function getStaticPaths() {
  return [{ params: { locale: "en" } }, { params: { locale: "zh" } }];
}

const locale = Astro.params.locale as Locale;
const other: Locale = locale === "en" ? "zh" : "en";

const entry = await getEntry("resources", locale);
const otherEntry = await getEntry("resources", other);
if (!entry || !otherEntry) throw new Error(`Missing resources content for ${locale}`);

const { Content } = await render(entry);
const dict = await getDictionary(locale);
---

<BaseLayout locale={locale} dict={dict} title={dict.nav.resources}>
	<PageHeader
		eyebrow={dict.nav.resources}
		title={entry.data.title}
		titleLang={locale}
		titleAlt={otherEntry.data.title}
		titleAltLang={other}
		intro={entry.data.intro}
	/>
	<Container class="py-16 lg:py-24">
		<Prose>
			<Content />
		</Prose>
	</Container>
</BaseLayout>
