---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Container from "@/components/Container.astro";
import PageHeader from "@/components/PageHeader.astro";
import Button from "@/components/Button.astro";
import { getEntry } from "astro:content";
import { getDictionary, type Locale } from "@/i18n/locales";

export function getStaticPaths() {
  return [{ params: { locale: "en" } }, { params: { locale: "zh" } }];
}

const locale = Astro.params.locale as Locale;
const other: Locale = locale === "en" ? "zh" : "en";

const entry = await getEntry("awards", locale);
const otherEntry = await getEntry("awards", other);
if (!entry || !otherEntry) throw new Error(`Missing awards content for ${locale}`);

const dict = await getDictionary(locale);
---

<BaseLayout locale={locale} dict={dict} title={dict.nav.awards}>
	<PageHeader
		eyebrow={dict.nav.awards}
		title={entry.data.title}
		titleLang={locale}
		titleAlt={otherEntry.data.title}
		titleAltLang={other}
		intro={entry.data.intro}
	/>
	<Container class="py-16 lg:py-24">
		<div class="grid gap-10">
			{entry.data.items.map((award) => (
				<article class="grid gap-4 border-l-2 border-primary pl-6 lg:grid-cols-[0.8fr_1.2fr] lg:gap-10">
					<div>
						{award.type && (
							<span class="font-mono text-xs uppercase tracking-[0.2em] text-ink-soft">{award.type}</span>
						)}
						<h2 class="mt-2 font-display text-2xl font-semibold text-ink">{award.name}</h2>
						{award.deadline && (
							<p class="mt-3 inline-block rounded-pill bg-gold/15 px-3 py-1 text-sm text-gold-deep">
								{award.deadline}
							</p>
						)}
					</div>
					<div>
						<p class="text-ink-soft">{award.description}</p>
						{award.link && (
							<div class="mt-4">
								<Button href={award.link.href} variant="outline">{award.link.label}</Button>
							</div>
						)}
					</div>
				</article>
			))}
		</div>
	</Container>
</BaseLayout>
