---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Section from "@/components/Section.astro";
import Card from "@/components/Card.astro";
import { getDictionary, type Locale } from "@/i18n/locales";

export function getStaticPaths() {
  return [{ params: { locale: "en" } }, { params: { locale: "zh" } }];
}

const locale = Astro.params.locale as Locale;
const dict = await getDictionary(locale);
---

<BaseLayout locale={locale} dict={dict}>
	<Section eyebrow="layout smoke test" sunk>
		<div class="grid gap-6 sm:grid-cols-3">
			<Card accent="seal">Seal card</Card>
			<Card accent="jade">Jade card</Card>
			<Card accent="gold">Gold card</Card>
		</div>
	</Section>
</BaseLayout>
