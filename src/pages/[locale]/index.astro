---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Container from "@/components/Container.astro";
import Section from "@/components/Section.astro";
import Card from "@/components/Card.astro";
import Button from "@/components/Button.astro";
import ImageFrame from "@/components/ImageFrame.astro";
import HeroSlideshow from "@/components/HeroSlideshow.astro";
import BilingualHeading from "@/components/signature/BilingualHeading.astro";
import Prose from "@/components/Prose.astro";
import { getEntry, render } from "astro:content";
import { getDictionary, type Locale } from "@/i18n/locales";
import { publicImageExists } from "@/lib/assets";

export function getStaticPaths() {
  return [{ params: { locale: "en" } }, { params: { locale: "zh" } }];
}

const locale = Astro.params.locale as Locale;
const other: Locale = locale === "en" ? "zh" : "en";

const homeEntry = await getEntry("home", locale);
const otherHomeEntry = await getEntry("home", other);
if (!homeEntry || !otherHomeEntry) throw new Error(`Missing home content for ${locale}`);

const { hero, pillars } = homeEntry.data;
const otherHero = otherHomeEntry.data.hero;
const { Content } = await render(homeEntry);
const dict = await getDictionary(locale);
const slides = homeEntry.data.slides.filter((s) => publicImageExists(s.image));
---

<BaseLayout locale={locale} dict={dict}>
	<section class="border-b border-line">
		<Container class="grid gap-10 py-16 sm:py-24 lg:grid-cols-[1.15fr_0.85fr] lg:items-center lg:gap-16">
			<div>
				<p class="font-mono text-xs uppercase tracking-[0.2em] text-ink-soft">{hero.eyebrow}</p>
				<BilingualHeading
					as="h1"
					size="hero"
					class="mt-5"
					primary={hero.heading}
					primaryLang={locale}
					secondary={otherHero.heading}
					secondaryLang={other}
				/>
				<p class="mt-6 max-w-reading text-lg text-ink-soft">{hero.intro}</p>
				<div class="mt-8 flex flex-wrap gap-3">
					<Button href={hero.primary.href}>{hero.primary.label}</Button>
					{hero.secondary && (
						<Button href={hero.secondary.href} variant="outline">
							{hero.secondary.label}
						</Button>
					)}
				</div>
			</div>
			<div class="relative">
				{slides.length > 0 ? (
					<HeroSlideshow slides={slides} class="aspect-[4/3] w-full" />
				) : (
					<ImageFrame src={hero.image} alt={hero.imageAlt ?? ""} class="aspect-[4/3] w-full" />
				)}
			</div>
		</Container>
	</section>

	<Section eyebrow={dict.labels.getInvolved}>
		<Prose class="text-lg">
			<Content />
		</Prose>
	</Section>

	<Section eyebrow="01 · 02 · 03" sunk>
		<div class="grid gap-6 md:grid-cols-3">
			{pillars.map((p) => (
				<Card accent={p.accent}>
					<h3 class="font-display text-lg font-semibold text-ink">{p.title}</h3>
					<p class="mt-3 text-sm text-ink-soft">{p.body}</p>
				</Card>
			))}
		</div>
	</Section>
</BaseLayout>
