---
import Container from "@/components/Container.astro";
import BilingualHeading from "@/components/signature/BilingualHeading.astro";
import type { Locale } from "@/i18n/locales";

interface Props {
  eyebrow: string;
  title: string;
  titleLang: Locale;
  titleAlt?: string;
  titleAltLang?: Locale;
  intro?: string;
}

const { eyebrow, title, titleLang, titleAlt, titleAltLang, intro } = Astro.props;
---

<section class="border-b border-line bg-paper-sunk">
  <Container class="py-14 sm:py-20">
    <p class="font-mono text-xs uppercase tracking-[0.2em] text-ink-soft">{eyebrow}</p>
    <BilingualHeading
      as="h1"
      size="hero"
      class="mt-4"
      primary={title}
      primaryLang={titleLang}
      secondary={titleAlt}
      secondaryLang={titleAltLang}
    />
    {intro && <p class="mt-5 max-w-reading text-lg text-ink-soft">{intro}</p>}
  </Container>
</section>
