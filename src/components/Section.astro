---
import { cn } from "@/lib/cn";
import Container from "@/components/Container.astro";

interface Props {
  eyebrow?: string;
  sunk?: boolean;
  class?: string;
  id?: string;
}

const { eyebrow, sunk = false, class: className, id } = Astro.props;
---

<section id={id} class={cn("py-16 sm:py-24", sunk && "bg-paper-sunk", className)}>
  <Container>
    <div class="grid gap-8 lg:grid-cols-[12rem_1fr] lg:gap-12">
      {eyebrow ? (
        <div class="lg:pt-1">
          <span class="inline-flex items-center gap-2 font-mono text-xs uppercase tracking-[0.2em] text-ink-soft">
            <span class="h-2 w-2 rounded-[2px] bg-primary" />
            {eyebrow}
          </span>
        </div>
      ) : (
        <div class="hidden lg:block" />
      )}
      <div>
        <slot />
      </div>
    </div>
  </Container>
</section>
