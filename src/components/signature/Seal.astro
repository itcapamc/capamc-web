---
import { cn } from "@/lib/cn";

interface Props {
  size?: number;
  chars?: string[];
  class?: string;
  interactive?: boolean;
}

const {
  size = 44,
  chars = ["华", "人", "家", "长"],
  class: className,
  interactive = true,
} = Astro.props;
---

<span
  aria-hidden="true"
  style={`width:${size}px;height:${size}px`}
  class={cn(
    "relative inline-grid shrink-0 grid-cols-2 place-items-center rounded-full bg-primary text-white select-none",
    interactive &&
      "transition-transform duration-(--motion-base) ease-(--ease-seal) hover:-rotate-3 hover:scale-105",
    className,
  )}
>
  <span class="pointer-events-none absolute inset-[3px] rounded-full border border-white/35" />
  {chars.slice(0, 4).map((c) => (
    <span class="font-cjk-sans leading-none" style={`font-size:${size * 0.3}px`}>
      {c}
    </span>
  ))}
</span>
