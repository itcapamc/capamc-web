---
import { cn } from "@/lib/cn";

interface Props {
  class?: string;
  priority?: boolean;
}

const { class: className, priority = false } = Astro.props;
---

<img
  src="/images/logo.png"
  alt="CAPA-MC · 蒙郡华裔家长联合会"
  width={249}
  height={263}
  loading={priority ? "eager" : "lazy"}
  fetchpriority={priority ? "high" : "auto"}
  class={cn("w-auto", className)}
/>
