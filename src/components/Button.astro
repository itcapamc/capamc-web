---
import { cn } from "@/lib/cn";

type Variant = "primary" | "outline" | "ghost";

const variants: Record<Variant, string> = {
  primary:
    "bg-primary text-white font-bold hover:bg-primary-deep border border-transparent shadow-card hover:-translate-y-0.5 hover:shadow-card-hover",
  outline:
    "border border-ink text-ink hover:bg-ink hover:text-paper bg-transparent",
  ghost: "text-ink hover:text-primary border border-transparent",
};

interface Props {
  href: string;
  variant?: Variant;
  class?: string;
}

const { href, variant = "primary", class: className } = Astro.props;
const cls = cn(
  "inline-flex items-center justify-center gap-2 rounded-pill px-5 py-2.5 text-sm",
  "transition-[color,background-color,transform,box-shadow] duration-(--motion-fast)",
  variants[variant],
  className,
);
const external = /^https?:\/\//.test(href);
---

{external ? (
  <a href={href} target="_blank" rel="noopener noreferrer" class={cls}>
    <slot />
  </a>
) : (
  <a href={href} class={cls}>
    <slot />
  </a>
)}
